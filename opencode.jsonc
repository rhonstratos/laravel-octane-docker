{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                // Adjust the path to your Laravel project's artisan file, or reinstall laravel boost in the project
                "wsl.exe",
                "/usr/bin/php8.5",
                "/home/vreiln/projects/laravel_api/artisan",
                "boost:mcp"
            ]
        }
    }
}